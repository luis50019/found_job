# Crea el bot con @BotFather y pega aqui el token.
TELEGRAM_BOT_TOKEN=123456789:reemplaza_este_token

# Tu ID numerico de Telegram. Puedes obtenerlo con @userinfobot.
# Acepta varios IDs separados por coma.
ALLOWED_TELEGRAM_USER_IDS=123456789

POSTGRES_PASSWORD=pon_aqui_una_contrasena_larga
DATABASE_URL=postgresql://jobradar:change_me@postgres:5432/jobradar

# Cada 6 horas. Formato cron.
CHECK_CRON=0 */6 * * *
MATCH_THRESHOLD=75
RUN_ON_STARTUP=true
MAX_NOTIFICATIONS_PER_RUN=10

# Fuentes sin credenciales.
ENABLE_REMOTIVE=true
ENABLE_REMOTEOK=true
ENABLE_ARBEITNOW=true

# Opcional: agrega busquedas en Mexico mediante Jooble.
# Solicita la clave en https://jooble.org/api/about
ENABLE_JOOBLE=true
JOOBLE_API_KEY=

# Opcional: agrega vacantes locales de Mexico mediante Adzuna.
# Crea las claves en https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

LOG_LEVEL=info
